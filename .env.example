# fin-news-assistant — env template
# cp .env.example .env and fill values. Never commit .env.

# Marketaux primary source (~50 req/day early)
MARKETAUX_API_TOKEN=

# Discord output (v1 only output)
DISCORD_WEBHOOK_URL=

# Paid 3.8B API (sunk monthly subscription, RM0 new spend) — used for hard reasoning
PAID_API_KEY=
PAID_MONTHLY_BUDGET=3800000000
HEADROOM_PCT=0.10

# Free tier AI — FreeLLMAPI local router (OpenAI-compatible), used for flash
# impact notes + daily PM summary now that the paid agent is dead.
# FREE_API_KEY = unified "freellmapi-..." key from the dashboard Keys page (http://127.0.0.1:3001).
FREE_API_KEY=
FREE_API_BASE=http://127.0.0.1:3001/v1
FREE_MODEL=auto

# SQLite dumb store (WAL, text-only)
DB_PATH=data/fin_news.db

# Feature flag: active | read_only (exam weeks — queue drains, no deploys)
FEATURE_FLAG=active

# Flash news live webhook (second Discord webhook — flash XAU/USD)
DISCORD_FLASH_WEBHOOK_URL=

# Finnhub — live quotes (free: /quote works, /candle needs premium)
FINNHUB_API_KEY=
