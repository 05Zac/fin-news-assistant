[Unit]
Description=Fin News Assistant — XAUUSD flash (InvestingLive + FF Calendar) → agent PM (Linux gateway 24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/.openclaw/workspace-gpt/fin-news-assistant
EnvironmentFile=/home/user/.openclaw/workspace-gpt/fin-news-assistant/.env
ExecStart=/bin/bash -c 'python3 src/flash_xau.py --limit 15 && python3 src/ingest.py --limit 10 --symbols USD,XAU && python3 src/resolver.py --limit 50 && python3 src/flash_notify.py --limit 10 && python3 src/validate.py --limit 50 && python3 src/agent_pm.py --limit 50 --post-discord'
