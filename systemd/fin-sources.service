[Unit]
Description=Fin News — official feeds (Fed, ECB press) → store → queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/.openclaw/workspace-gpt/fin-news-assistant
EnvironmentFile=/home/user/.openclaw/workspace-gpt/fin-news-assistant/.env
# each source runs on its own; a failing one cools off without blocking the other
ExecStart=/bin/bash -c 'flock -n /tmp/fin-sources.lock bash -c "python3 src/flash_poll.py --source fed --limit 20 --enqueue-only; python3 src/flash_poll.py --source ecb --limit 20 --enqueue-only"'
